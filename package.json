{
  "name": "helix",
  "version": "0.0.0",
  "private": true,
  "description": "A 2D hero-combat game for the browser",
  "type": "module",
  "packageManager": "pnpm@12.5.1",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test",
    "check:ci": "pnpm lint && pnpm typecheck && pnpm build && vitest run --coverage",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "dev": "vite",
    "build": "vite build",
    "bench": "echo 'pnpm bench: not yet. The render benchmark scene does not exist' && exit 1"
  },
  "dependencies": {
    "phaser": "4.2.1"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "24.13.6",
    "@vitest/coverage-v8": "5.0.1",
    "eslint": "10.11.0",
    "eslint-plugin-perfectionist": "5.11.1",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.12.0",
    "jsdom": "30.1.0",
    "prettier": "3.9.8",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
